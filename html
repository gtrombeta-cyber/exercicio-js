<script>
  // exercicio 10
  let idade = parseInt(prompt("digite a idade do nadador"))

  if (idade >= 5 && idade <= 7) {
    alert("infantil a")
  } else if (idade >= 8 && idade <= 10) {
    alert("infantil b")
  } else if (idade >= 11 && idade <= 13) {
    alert("juvenil a")
  } else if (idade >= 14 && idade <= 17) {
    alert("juvenil b")
  } else if (idade >= 18) {
    alert("adulto")
  } else {
    alert("idade invalida")
  }
</script>

<script>
  // exercicio 11
  let angulo = parseFloat(prompt("digite a medida do angulo"))

  if (angulo === 0 || angulo === 180) {
    alert("angulo raso")
  } else if (angulo === 360) {
    alert("angulo completo")
  } else if (angulo > 0 && angulo < 90) {
    alert("angulo agudo")
  } else if (angulo === 90) {
    alert("angulo reto")
  } else if (angulo > 90 && angulo < 180) {
    alert("angulo otuso")
  } else if (angulo > 180 && angulo < 360) {
    alert("angulo concavo")
  } else {
    alert("angulo invalido")
  }
</script>

<script>
  // exercicio 12
  let codigo = parseInt(prompt("digite o codigo do produto (200-203)"))
  let quantidade = parseInt(prompt("digite a quantidade"))

  let preco = 0
  let produto = ""

  if (codigo === 200) {
    preco = 25
    produto = "camiseta"
  } else if (codigo === 201) {
    preco = 35
    produto = "calca"
  } else if (codigo === 202) {
    preco = 45
    produto = "jaqueta"
  } else if (codigo === 203) {
    preco = 55
    produto = "saia"
  } else {
    alert("codigo invalido")
  }

  if (preco > 0) {
    let total = preco * quantidade
    alert(produto + " - quantidade: " + quantidade + " - total: r$ " + total.toFixed(2))
  }
</script>
